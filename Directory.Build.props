<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>CyberNet Labs</Company>
    <Product>Apex Activity Manager</Product>
    <Copyright>© 2026 CyberNet Labs</Copyright>
    <Version>1.4.1</Version>
    <!-- Off Windows (development on a Mac in a synced folder): build output goes to the temp folder. -->
    <UseArtifactsOutput Condition="'$(OS)' != 'Windows_NT'">true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(OS)' != 'Windows_NT'">$(TMPDIR)apex-windows-artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
